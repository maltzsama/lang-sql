{
  "name": "@maltzsama/lang-sql",
  "version": "6.12.1",
  "description": "SQL language support for the CodeMirror code editor, with 30+ SQL dialects",
  "scripts": {
    "test": "cm-runtests",
    "build": "cm-buildhelper src/sql.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "generate-dialects": "node scripts/generate-dialects.mjs"
  },
  "keywords": [
    "editor",
    "code",
    "sql"
  ],
  "author": {
    "name": "Demetrius Albuquerque",
    "email": "demetrius.albuquerque@yahoo.com.br"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "^1.0.0",
    "@types/mocha": "^9.1.1",
    "sqlingo": "0.12.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maltzsama/lang-sql.git"
  },
  "homepage": "https://github.com/maltzsama/lang-sql#readme",
  "bugs": {
    "url": "https://github.com/maltzsama/lang-sql/issues"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4"
  }
}
